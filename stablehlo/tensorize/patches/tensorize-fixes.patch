+def integral_floats_to_ints(expr):
+    """Replace integral Floats by Integers. The traced source gets e.g. `A > 0` while
+    candidates get `A > 0.0`, which sympy considers structurally different."""
+    if not isinstance(expr, sympy.Basic):
+        return expr
+    floats = {f: sympy.Integer(int(f)) for f in expr.atoms(sympy.Float) if f == int(f)}
+    return expr.xreplace(floats) if floats else expr
+
